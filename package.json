{
  "name": "rls-lint",
  "version": "1.0.0",
  "description": "Static security linter for Supabase Row Level Security policies. Catch multi-tenant data leaks before you ship.",
  "keywords": [
    "supabase",
    "postgresql",
    "security",
    "cli",
    "linter",
    "rls",
    "typescript"
  ],
  "homepage": "https://github.com/NavjotSingh-ca/rls-lint#readme",
  "bugs": {
    "url": "https://github.com/NavjotSingh-ca/rls-lint/issues"
  },
  "license": "MIT",
  "author": "Navjot Singh",
  "repository": {
    "type": "git",
    "url": "https://github.com/NavjotSingh-ca/rls-lint.git"
  },
  "type": "module",
  "bin": {
    "rls-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}